---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Kitchen — hideaway."
  description="The Kitchen is where Hideaway's tools live. Bring the half-baked thing and we'll help you work out what it needs next."
>

  <!-- Hero -->
  <section class="kitchen-hero">
    <div class="hero-inner">
      <div class="hero-tag">Workspace</div>
      <h1>The<span class="accent"> Kitchen.</span></h1>
      <p class="hero-headline">Bring the half-baked thing. We'll help you work out what it needs next.</p>
      <p class="hero-sub">The Kitchen is where Hideaway's tools live. Use it when you already have something to work on and want the right next move.</p>
    </div>
  </section>

  <!-- Distinction -->
  <section class="kitchen-distinction">
    <div class="distinction-inner">
      <p class="distinction-line">Take the <a href="/diagnostic">Makers Memo</a> when you want the whole pattern. Come to The Kitchen when you've got something to work on.</p>
    </div>
  </section>

  <!-- Routing cards -->
  <section class="kitchen-routing">
    <div class="routing-inner">
      <h2 class="section-eyebrow">Where are you?</h2>

      <div class="routing-grid">

        <!-- 1. Cooking — coming soon -->
        <article class="routing-card coming">
          <div class="card-head">
            <span class="status-pill coming">Coming soon</span>
            <h3>What have you got cooking?</h3>
            <p class="card-desc">For raw material, scattered notes, early ideas, or things you haven't shaped yet.</p>
          </div>
          <div class="card-body">
            <p class="route-line muted"><span class="route-label">Coming:</span> Capture tool / raw material organiser.</p>
            <p class="card-note">For now, take the <a href="/diagnostic">Makers Memo</a> if you want a wider read on where the material is catching.</p>
          </div>
        </article>

        <!-- 2. Half-baked — live -->
        <article class="routing-card live">
          <div class="card-head">
            <span class="status-pill live">Live</span>
            <h3>What's half-baked?</h3>
            <p class="card-desc">For ideas that need pressure-testing, sharper framing, or a more honest look before you commit.</p>
          </div>
          <div class="card-body">
            <p class="route-line"><span class="route-label">Now:</span> <a href="/prompt-lab" class="route-link">Prompt Lab →</a></p>
            <p class="card-note">Prompt Lab is useful when the issue is how the idea or ask is being framed.</p>
            <p class="route-line muted"><span class="route-label">Coming:</span> Pressure-Test Pack.</p>
          </div>
        </article>

        <!-- 3. Ready to build — live -->
        <article class="routing-card live">
          <div class="card-head">
            <span class="status-pill live">Live</span>
            <h3>What's ready to build?</h3>
            <p class="card-desc">For ideas that need turning into a first practical version.</p>
          </div>
          <div class="card-body">
            <p class="route-line"><span class="route-label">Now:</span> <a href="/builder-brief" class="route-link">Builder Brief →</a></p>
            <p class="card-note">The clearest live route. A rough idea in, a structured build brief out.</p>
          </div>
        </article>

        <!-- 4. Tasting — coming soon -->
        <article class="routing-card coming">
          <div class="card-head">
            <span class="status-pill coming">Coming soon</span>
            <h3>What needs tasting?</h3>
            <p class="card-desc">For drafts, products, prompts, or offers that need critique before release.</p>
          </div>
          <div class="card-body">
            <p class="route-line muted"><span class="route-label">Coming:</span> Critique / Definition of Done.</p>
            <p class="card-note">For now, use <a href="/prompt-lab">Prompt Lab</a> only if what you're testing is an AI prompt.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Available tools -->
  <section class="kitchen-tools">
    <div class="tools-inner">
      <h2 class="section-eyebrow">Available tools</h2>
      <p class="tools-desc">If you already know which tool you want, go directly.</p>

      <div class="tools-row">

        <a class="tool-card" href="/prompt-lab">
          <h3>Prompt Lab</h3>
          <p>Sharpen what you're asking the AI. Rough prompt in, stronger instruction out.</p>
          <span class="tool-arrow">Open →</span>
        </a>

        <a class="tool-card" href="/builder-brief">
          <h3>Builder Brief</h3>
          <p>Turn a rough idea into a structured build brief with an AI-build-ready prompt.</p>
          <span class="tool-arrow">Open →</span>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── Hero ──────────────────────────────────────────── */
  .kitchen-hero {
    background: var(--navy);
    padding: 9rem 3rem 4rem;
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-block;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.55);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }

  .kitchen-hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 500;
    color: white;
    line-height: 1.05;
    margin: 0 0 1.4rem;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .kitchen-hero h1 .accent {
    color: var(--yellow);
  }

  .hero-headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 400;
    color: white;
    line-height: 1.35;
    margin: 0 0 1rem;
    max-width: 600px;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    max-width: 560px;
    margin: 0;
  }

  /* ─── Distinction ───────────────────────────────────── */
  .kitchen-distinction {
    background: var(--frosted);
    padding: 2.5rem 3rem 0.5rem;
  }

  .distinction-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .distinction-line {
    font-size: 1rem;
    color: var(--text-light);
    line-height: 1.65;
    margin: 0;
    padding: 1.1rem 1.3rem;
    background: white;
    border: 1px solid var(--stone);
    border-left: 3px solid var(--sage);
    border-radius: 8px;
  }

  .distinction-line a {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(26,39,68,0.25);
  }

  .distinction-line a:hover {
    border-bottom-color: var(--navy);
  }

  /* ─── Routing cards ─────────────────────────────────── */
  .kitchen-routing {
    background: var(--frosted);
    padding: 2rem 3rem 4rem;
  }

  .routing-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26,39,68,0.5);
    margin: 0 0 1.2rem;
  }

  .routing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .routing-card {
    background: white;
    border: 1px solid var(--stone);
    border-radius: 10px;
    padding: 1.6rem 1.7rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .routing-card.coming {
    background: rgba(255,255,255,0.55);
    border-color: rgba(212,207,196,0.6);
  }

  .card-head {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .status-pill {
    align-self: flex-start;
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 4px;
  }

  .status-pill.live {
    background: var(--yellow);
    color: var(--navy);
  }

  .status-pill.coming {
    background: rgba(26,39,68,0.06);
    color: rgba(26,39,68,0.55);
    border: 1px solid rgba(26,39,68,0.1);
  }

  .routing-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--navy);
    margin: 0;
    line-height: 1.25;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .routing-card.coming h3 {
    color: rgba(26,39,68,0.7);
  }

  .card-desc {
    font-size: 0.93rem;
    color: var(--text-light);
    line-height: 1.55;
    margin: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-top: 0.4rem;
    border-top: 1px dashed rgba(26,39,68,0.08);
  }

  .route-line {
    font-size: 0.9rem;
    color: var(--navy);
    margin: 0;
    line-height: 1.5;
  }

  .route-line.muted {
    color: rgba(26,39,68,0.55);
  }

  .route-label {
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-right: 0.3rem;
    color: rgba(26,39,68,0.45);
  }

  .route-link {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(26,39,68,0.3);
    transition: border-color 0.2s;
  }

  .route-link:hover {
    border-bottom-color: var(--navy);
  }

  .card-note {
    font-size: 0.86rem;
    color: rgba(26,39,68,0.6);
    line-height: 1.55;
    margin: 0;
    font-style: italic;
  }

  .card-note a {
    color: rgba(26,39,68,0.85);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(26,39,68,0.25);
    font-style: normal;
  }

  .card-note a:hover {
    border-bottom-color: var(--navy);
  }

  /* ─── Available tools ───────────────────────────────── */
  .kitchen-tools {
    background: white;
    padding: 4rem 3rem 5rem;
    border-top: 1px solid var(--border);
  }

  .tools-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .tools-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .tools-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .tool-card {
    display: block;
    background: var(--frosted);
    border: 1px solid var(--stone);
    border-radius: 10px;
    padding: 1.4rem 1.6rem 1.3rem;
    text-decoration: none;
    color: var(--navy);
    transition: border-color 0.2s, transform 0.2s;
  }

  .tool-card:hover {
    border-color: var(--sage);
    transform: translateY(-1px);
  }

  .tool-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 0.4rem;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .tool-card p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.55;
    margin: 0 0 0.7rem;
  }

  .tool-arrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--navy);
  }

  /* ─── Responsive ────────────────────────────────────── */
  @media (max-width: 760px) {
    .kitchen-hero { padding: 8rem 1.5rem 3rem; }
    .kitchen-distinction { padding: 2rem 1.5rem 0.5rem; }
    .kitchen-routing { padding: 1.5rem 1.5rem 3rem; }
    .kitchen-tools { padding: 3rem 1.5rem; }
    .routing-grid { grid-template-columns: 1fr; }
    .tools-row { grid-template-columns: 1fr; }
  }
</style>
</BaseLayout>
