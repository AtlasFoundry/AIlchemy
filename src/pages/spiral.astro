---
import BaseLayout from '../layouts/BaseLayout.astro';
import entries from '../content/spiral/entries.json';
---

<BaseLayout
  title="The Spiral — hideaway."
  description="The words don't change. The person repeating them does. A quiet gallery of practices for meeting resistance and moving from desire to action."
>

  <!-- Intro -->
  <section class="spiral-intro">
    <div class="intro-inner">
      <span class="spiral-eyebrow">Practice</span>
      <h1>The Spiral</h1>
      <p class="core-line">The words don't change. The person repeating them does.</p>

      <div class="intro-body">
        <p>Sometimes the thought that appears first is not the one we want to keep practising.</p>
        <p>The Spiral is a simple practice I use when fear, doubt or an old pattern interrupts something I want to do. I name the thought without fighting it, then repeat a gentler and more accurate thought three times.</p>
        <p>We often return to the same fears and questions. That does not mean we have gone backwards. A spiral brings us past familiar ground with more awareness, stronger tools and a different view.</p>
        <p>Choose the thought that feels familiar. Stay with the programming for a moment. Return whenever you need it.</p>
        <p class="intro-note">This is a practice from my own life, shared in case it serves you.</p>
      </div>
    </div>
  </section>

  <!-- Practices -->
  <section class="spiral-gallery" aria-label="Practices">
    <div class="gallery-inner">
      <h2 class="gallery-label">The practices</h2>

      <div class="spiral-grid">
        {entries.map((entry) => (
          <article class="practice-card">
            {entry.category && <h3 class="practice-category">{entry.category}</h3>}

            <div class="practice-block practice-thought">
              <span class="practice-label">Thought</span>
              <p class="thought-text">{entry.thought}</p>
            </div>

            <div class="practice-block practice-programming">
              <span class="practice-label">Programming</span>
              {Array.from({ length: 3 }).map(() => (
                <p class="programming-line">{entry.programming}</p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Intro ─────────────────────────────────── */
  .spiral-intro {
    padding: 8rem 2rem 3rem;
  }

  .intro-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .spiral-eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-light);
    background: rgba(26, 39, 68, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }

  .spiral-intro h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.6rem, 5.5vw, 4rem);
    font-weight: 500;
    color: var(--navy);
    line-height: 1.05;
    margin: 0 0 1.2rem;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .core-line {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    font-weight: 400;
    color: var(--navy);
    line-height: 1.4;
    margin: 0 0 2.2rem;
    max-width: 520px;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .intro-body p {
    font-size: 1.02rem;
    color: var(--text-light);
    line-height: 1.7;
    margin: 0 0 1rem;
    max-width: 600px;
  }

  .intro-body .intro-note {
    font-style: italic;
    color: rgba(26, 39, 68, 0.5);
    margin-top: 1.4rem;
  }

  /* ── Gallery ───────────────────────────────── */
  .spiral-gallery {
    padding: 2rem 2rem 6rem;
  }

  .gallery-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .gallery-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 39, 68, 0.45);
    margin: 0 0 1.4rem;
  }

  .spiral-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }

  .practice-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.7rem 1.7rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .practice-card:hover {
    box-shadow: 0 6px 24px rgba(26, 39, 68, 0.08);
    border-color: var(--stone);
    transform: translateY(-1px);
  }

  .practice-category {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--navy);
    margin: 0;
    line-height: 1.25;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .practice-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .practice-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .thought-text {
    font-size: 0.98rem;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  .practice-programming {
    border-left: 2px solid var(--sage);
    padding-left: 1rem;
    gap: 0.3rem;
  }

  .programming-line {
    font-family: 'Fraunces', serif;
    font-size: 1.04rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.45;
    margin: 0;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 700px) {
    .spiral-intro { padding: 7rem 1.5rem 2.5rem; }
    .spiral-gallery { padding: 1.5rem 1.5rem 4rem; }
    .spiral-grid { grid-template-columns: 1fr; }
    .practice-card { padding: 1.5rem; }
  }
</style>
