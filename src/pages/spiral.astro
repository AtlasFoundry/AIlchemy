---
import BaseLayout from '../layouts/BaseLayout.astro';
import entries from '../content/spiral/entries.json';
---

<BaseLayout
  title="The Spiral — hideaway."
  description="The words don't change. The person repeating them does. A quiet gallery of practices for meeting resistance and moving from desire to action."
>

  <!-- Intro -->
  <section class="spiral-intro">
    <div class="intro-inner">
      <span class="spiral-eyebrow">Practice</span>
      <h1>
        <span class="title-text">The Spiral</span>
        <svg class="spiral-mark" viewBox="1 2 26.3 35.9" fill="none" aria-hidden="true" focusable="false">
          <path d="M15.00 4.00 L15.08 4.37 L15.16 4.75 L15.23 5.13 L15.28 5.50 L15.30 5.85 L15.30 6.20 L15.27 6.52 L15.21 6.83 L15.12 7.11 L15.00 7.36 L14.85 7.58 L14.68 7.77 L14.49 7.92 L14.29 8.05 L14.09 8.15 L13.89 8.22 L13.70 8.26 L13.53 8.29 L13.39 8.29 L13.29 8.29 L13.22 8.27 L13.21 8.26 L13.24 8.25 L13.34 8.25 L13.48 8.27 L13.69 8.31 L13.95 8.38 L14.26 8.48 L14.61 8.61 L15.00 8.79 L15.42 9.00 L15.85 9.25 L16.28 9.55 L16.71 9.89 L17.12 10.26 L17.50 10.67 L17.83 11.11 L18.10 11.58 L18.30 12.07 L18.43 12.57 L18.47 13.08 L18.42 13.59 L18.28 14.09 L18.05 14.57 L17.73 15.03 L17.32 15.46 L16.83 15.86 L16.27 16.22 L15.66 16.52 L15.00 16.79 L14.32 17.00 L13.62 17.15 L12.94 17.26 L12.28 17.32 L11.67 17.33 L11.12 17.29 L10.65 17.22 L10.27 17.12 L10.01 17.00 L9.86 16.86 L9.84 16.71 L9.95 16.57 L10.19 16.43 L10.56 16.32 L11.06 16.24 L11.67 16.19 L12.39 16.19 L13.20 16.23 L14.07 16.34 L15.00 16.50 L15.95 16.72 L16.91 17.01 L17.84 17.36 L18.73 17.77 L19.55 18.23 L20.27 18.74 L20.88 19.30 L21.36 19.89 L21.69 20.51 L21.86 21.14 L21.86 21.79 L21.68 22.42 L21.34 23.05 L20.82 23.65 L20.15 24.21 L19.33 24.73 L18.39 25.19 L17.33 25.60 L16.19 25.94 L15.00 26.21 L13.78 26.41 L12.56 26.54 L11.38 26.60 L10.26 26.58 L9.24 26.50 L8.34 26.37 L7.59 26.18 L7.01 25.96 L6.62 25.70 L6.43 25.43 L6.45 25.15 L6.69 24.87 L7.13 24.62 L7.79 24.39 L8.64 24.20 L9.66 24.07 L10.84 23.99 L12.14 23.99 L13.54 24.06 L15.00 24.21 L16.49 24.45 L17.97 24.77 L19.40 25.17 L20.74 25.64 L21.97 26.19 L23.04 26.81 L23.94 27.48 L24.62 28.20 L25.07 28.94 L25.29 29.71 L25.24 30.49 L24.95 31.26 L24.39 32.01 L23.60 32.72 L22.58 33.39 L21.35 33.99 L19.94 34.53 L18.39 34.99 L16.73 35.36 L15.00 35.64 L13.24 35.83 L11.50 35.93 L9.82 35.93 L8.25 35.85 L6.82 35.68 L5.57 35.44 L4.54 35.14 L3.75 34.79 L3.23 34.41 L3.00 34.00" />
        </svg>
      </h1>
      <p class="core-line">The words don't change. The person repeating them does.</p>

      <div class="intro-body">
        <p>Sometimes the thought that appears first is not the one we want to keep practising.</p>
        <p>The Spiral is a simple practice I use when fear, doubt or an old pattern interrupts something I want to do. I name the thought without fighting it, then repeat a gentler and more accurate thought three times.</p>
        <p>We often return to the same fears and questions. That does not mean we have gone backwards. A spiral brings us past familiar ground with more awareness, stronger tools and a different view.</p>
        <p>Choose the thought that feels familiar. Stay with the reminder for a moment. Return whenever you need it.</p>
        <p class="intro-note">This is a practice from my own life, shared in case it serves you.</p>
      </div>
    </div>
  </section>

  <!-- Practices -->
  <section class="spiral-gallery" aria-label="Practices">
    <div class="gallery-inner">
      <h2 class="gallery-label">The practices</h2>

      <div class="spiral-grid">
        {entries.map((entry) => (
          <article class="practice-card">
            {entry.category && <h3 class="practice-category">{entry.category}</h3>}

            <div class="practice-block practice-thought">
              <span class="practice-label">Thought</span>
              <p class="thought-text">{entry.thought}</p>
            </div>

            <div class="practice-block practice-programming">
              <span class="practice-label">I remind myself</span>
              {Array.from({ length: 3 }).map(() => (
                <p class="programming-line">{entry.programming}</p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Intro ─────────────────────────────────── */
  .spiral-intro {
    padding: 8rem 2rem 3rem;
  }

  .intro-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .spiral-eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-light);
    background: rgba(26, 39, 68, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }

  .spiral-intro h1 {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: 'Fraunces', serif;
    font-size: clamp(2.6rem, 5.5vw, 4rem);
    font-weight: 500;
    color: var(--navy);
    line-height: 1.05;
    margin: 0 0 1.2rem;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .spiral-mark {
    height: 1.15em;
    width: auto;
    flex-shrink: 0;
    align-self: flex-start;
  }

  .spiral-mark path {
    stroke: var(--yellow);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .core-line {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    font-weight: 400;
    color: var(--navy);
    line-height: 1.4;
    margin: 0 0 2.2rem;
    max-width: 520px;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .intro-body p {
    font-size: 1.02rem;
    color: var(--text-light);
    line-height: 1.7;
    margin: 0 0 1rem;
    max-width: 600px;
  }

  .intro-body .intro-note {
    font-style: italic;
    color: rgba(26, 39, 68, 0.5);
    margin-top: 1.4rem;
  }

  /* ── Gallery ───────────────────────────────── */
  .spiral-gallery {
    padding: 2rem 2rem 6rem;
  }

  .gallery-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .gallery-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 39, 68, 0.45);
    margin: 0 0 1.4rem;
  }

  .spiral-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }

  .practice-card {
    background: var(--navy);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1.7rem 1.7rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    box-shadow: 0 2px 12px rgba(26, 39, 68, 0.10);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .practice-card:hover {
    box-shadow: 0 8px 26px rgba(26, 39, 68, 0.18);
    border-color: rgba(156, 175, 136, 0.5);
    transform: translateY(-1px);
  }

  .practice-category {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: white;
    margin: 0;
    line-height: 1.25;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  .practice-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .practice-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .thought-text {
    font-size: 0.98rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
    margin: 0;
  }

  .practice-programming {
    border-left: 2px solid var(--sage);
    padding-left: 1rem;
    gap: 0.3rem;
  }

  .programming-line {
    font-family: 'Fraunces', serif;
    font-size: 1.04rem;
    font-weight: 500;
    color: white;
    line-height: 1.45;
    margin: 0;
    font-optical-sizing: none;
    font-feature-settings: normal;
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 700px) {
    .spiral-intro { padding: 7rem 1.5rem 2.5rem; }
    .spiral-gallery { padding: 1.5rem 1.5rem 4rem; }
    .spiral-grid { grid-template-columns: 1fr; }
    .practice-card { padding: 1.5rem; }
  }
</style>
